{
  "name": "yield-router",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "ci": "pnpm run typecheck && pnpm run build && pnpm run test",
    "demo": "node scripts/demo.ts",
    "fork": "node scripts/fork.ts",
    "fork:smoke": "node scripts/fork-smoke.ts",
    "reproduce": "node scripts/fork-preflight.ts && node scripts/reproduce.ts",
    "router": "node src/cli.ts",
    "test": "vitest run --exclude \"src/**/*.fork.test.ts\"",
    "test:fork": "node scripts/fork-preflight.ts && vitest run src/router.fork.test.ts --testTimeout 120000 --hookTimeout 60000 --bail 1",
    "typecheck": "tsc && tsc -p tsconfig.web.json",
    "web": "node scripts/web.ts"
  },
  "dependencies": {
    "@kamino-finance/klend-sdk": "14.0.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@solana/sysvars": "8.6.0",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/react": "0.1.0-beta.16",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@solana/surfpool": "1.7.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
